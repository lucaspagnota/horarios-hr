rules_version = '2';
// Só a conta do Lucas lê e grava. Troque SEU_UID pelo UID que aparece em Authentication > Usuários.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == "SEU_UID";
    }
  }
}
